PORT=3065
NODE_ENV=development

# Fail closed by default. Azure OpenAI is the only supported runtime.
AI_FEATURE_ENABLED=false
AI_WEBSEARCH_COMPLIANCE_CONFIRMED=false

# The endpoint must use HTTPS on *.openai.azure.com. It may be either the
# resource root or end in /openai/v1; the service normalizes the resource root.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

REDIS_URL=redis://redis:6379
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_DATABASE=api_ai_websearch

PROFILE_JOB_TTL_SECONDS=3600
PROFILE_RESULT_TTL_SECONDS=1800
PROVIDER_PROFILE_SEARCH_CONCURRENCY=2
