PORT=3065
NODE_ENV=development

# Fail closed by default. Azure OpenAI is the only supported runtime.
AI_FEATURE_ENABLED=false
AI_WEBSEARCH_COMPLIANCE_CONFIRMED=false

# The endpoint must use HTTPS on *.openai.azure.com. It may be either the
# resource root or end in /openai/v1; the service normalizes the resource root.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-terra
AI_WEBSEARCH_TOOL_CHOICE=required
AI_WEBSEARCH_MAX_TOOL_CALLS=8
AI_WEBSEARCH_PARALLEL_TOOL_CALLS=true
AI_REASONING_EFFORT=low
AI_WEBSEARCH_ALLOWED_DOMAINS=
AI_WEBSEARCH_BLOCKED_DOMAINS=

# Optional estimated-cost rate card. Token/call telemetry is emitted even when
# these are blank. Use Azure contracted rates; public list prices are not
# authoritative for Azure invoices. Set a cache-write
# rate only when the contract prices cache writes as a separate input category.
AI_COST_INPUT_USD_PER_MILLION=
AI_COST_CACHED_INPUT_USD_PER_MILLION=
AI_COST_OUTPUT_USD_PER_MILLION=
AI_COST_CACHE_WRITE_USD_PER_MILLION=
AI_COST_WEB_SEARCH_USD_PER_THOUSAND=
AI_COST_PRICING_VERSION=

REDIS_URL=redis://redis:6379
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_DATABASE=api_ai_websearch

PROFILE_JOB_TTL_SECONDS=3600
PROFILE_RESULT_TTL_SECONDS=1800
PROVIDER_PROFILE_SEARCH_CONCURRENCY=2
