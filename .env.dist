PORT=3065
NODE_ENV=development

# Fail closed by default. Runtime providers are limited to openai or azure.
AI_FEATURE_ENABLED=false
AI_WEBSEARCH_COMPLIANCE_CONFIRMED=false

# Shared OpenAI/Azure OpenAI Responses config. Azure is selected automatically
# when AI_BASE_URL points at *.openai.azure.com or contains /openai/v1.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-5.5
AI_WEBSEARCH_TOOL_CHOICE=required
AI_WEBSEARCH_MAX_TOOL_CALLS=8
AI_WEBSEARCH_PARALLEL_TOOL_CALLS=true
AI_REASONING_EFFORT=medium
AI_OPENAI_WEBSEARCH_CONTEXT_SIZE=medium
AI_WEBSEARCH_ALLOWED_DOMAINS=
AI_WEBSEARCH_BLOCKED_DOMAINS=

REDIS_URL=redis://redis:6379
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_DATABASE=api_ai_websearch

PROFILE_JOB_TTL_SECONDS=3600
PROFILE_RESULT_TTL_SECONDS=1800
PROVIDER_PROFILE_SEARCH_CONCURRENCY=2
FEEDBACK_NOTE_MAX_LENGTH=240
