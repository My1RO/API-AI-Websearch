PORT=3065
NODE_ENV=development

# Fail closed by default. Runtime providers are limited to openai or azure.
AI_FEATURE_ENABLED=false
AI_PROVIDER=openai
AI_WEBSEARCH_COMPLIANCE_CONFIRMED=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_WEB_SEARCH_EXTERNAL_ACCESS=false
OPENAI_STORE=false

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_CONTENT_LOGGING_CONFIRMED=false

REDIS_URL=redis://redis:6379
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_DATABASE=api_ai_websearch

PROFILE_JOB_TTL_SECONDS=3600
PROFILE_RESULT_TTL_SECONDS=1800
FEEDBACK_NOTE_MAX_LENGTH=240
