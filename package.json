{
  "name": "api-ai-websearch",
  "version": "1.0.0",
  "description": "AI-sourced provider profile service for Lucie EDE",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "migrate": "ts-node src/db/migrate.ts up",
    "migrate:revert": "ts-node src/db/migrate.ts down",
    "start": "node build/index.js",
    "smoke:live-provider": "node -r ./node_modules/ts-node/register scripts/provider-profile-live-smoke.ts",
    "eval:provider": "node -r ./node_modules/ts-node/register scripts/provider-profile-eval.ts",
    "test:eval": "cross-env NODE_ENV=test AI_FEATURE_ENABLED=false AI_WEBSEARCH_COMPLIANCE_CONFIRMED=false jest --runInBand tests/provider-profile-eval.test.js",
    "test": "cross-env NODE_ENV=test AI_FEATURE_ENABLED=false AI_WEBSEARCH_COMPLIANCE_CONFIRMED=false jest --coverage --forceExit",
    "test:db": "cross-env NODE_ENV=test AI_FEATURE_ENABLED=false AI_WEBSEARCH_COMPLIANCE_CONFIRMED=false AI_WEBSEARCH_DB_INTEGRATION_TEST=true jest --runInBand tests/typeorm-migrations.integration.test.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "mysql2": "^3.11.5",
    "openai": "^5.0.1",
    "reflect-metadata": "^0.1.13",
    "typeorm": "^0.3.19",
    "uuid": "^10.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 30000,
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/index.ts"
    ]
  }
}
